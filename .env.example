# =====================================================
#  CHUBBY LUNG SHOP — mẫu cấu hình môi trường
#  Cách dùng:  cp .env.example .env   rồi điền giá trị thật
#  File .env KHÔNG đưa lên GitHub
# =====================================================

# ----- Server -----
NODE_ENV=development
HOST=0.0.0.0
PORT=5000
# Chạy trực tiếp (không qua nginx) -> false. Trên EC2 sau nginx -> 1
TRUST_PROXY=false

# ----- Phiên đăng nhập -----
# Chuỗi ngẫu nhiên dài. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Chỉ bật true khi đã có HTTPS
COOKIE_SECURE=false

# ----- Tài khoản quản trị (/admin/login) -----
ADMIN_USER=admin
ADMIN_PASS=

# ----- Giới hạn đăng nhập sai -----
# Số lần sai tối đa / 15 phút / IP
LOGIN_MAX_ATTEMPTS=10

# ----- Cơ sở dữ liệu PostgreSQL (Prisma) -----
# Dạng: postgresql://TÊN_USER:MẬT_KHẨU@HOST:PORT/TÊN_DB
# Mật khẩu có ký tự đặc biệt thì mã hoá URL (@ -> %40, # -> %23, / -> %2F ...)
DATABASE_URL=postgresql://postgres:mat_khau@localhost:5432/chubbylung?schema=public

# ----- Ảnh, log -----
IMAGE_DIR=./imgs
LOG_DIR=./logs

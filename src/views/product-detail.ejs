<%- include('partials/head') %>
<% const stock = parseInt(p.stock, 10) || 0; %>
<div class="section" id="productRoot" data-pid="<%= p.id %>" data-stock="<%= Math.max(stock, 1) %>">
  <div style="font-size:13px;color:var(--text3);margin-bottom:24px">
    <a href="/" style="color:var(--accent)">Trang chủ</a> /
    <a href="/products" style="color:var(--accent)">Sản phẩm</a> / <%= p.name %>
  </div>
  <div class="detail-layout">
    <div class="detail-img">
      <% if (p.img_file) { %><img src="/imgs/<%= p.img_file %>" alt="<%= p.name %>" style="width:100%;height:100%;object-fit:contain;padding:16px"><% } else { %><span style="font-size:14px;color:var(--text3)">No image</span><% } %>
    </div>
    <div>
      <div class="card-tags" style="margin-bottom:12px"><% (p.tags || []).forEach(function (t) { %><span class="tag tag-<%= tagClass(t) %>"><%= t %></span><% }); %></div>
      <h1 class="detail-name"><%= p.name %></h1>
      <div style="display:flex;align-items:baseline;gap:8px;flex-wrap:wrap">
        <span class="detail-price"><%= fmt(p.price) %></span>
        <span class="detail-price-old"><%= fmt(p.original_price) %></span>
        <span class="price-discount" style="font-size:14px;padding:4px 10px">-<%= discountPercent(p) %>%</span>
      </div>

      <div class="detail-meta" style="margin-top:20px">
        <div class="meta-item"><div class="meta-item-label">Nhân vật</div><div class="meta-item-value" style="font-size:13px"><%= p.nhan_vat || '—' %></div></div>
        <div class="meta-item"><div class="meta-item-label">Kích thước</div><div class="meta-item-value" style="font-size:13px"><%= p.kich_thuoc || '—' %></div></div>
        <div class="meta-item"><div class="meta-item-label">Đã bán</div><div class="meta-item-value"><%= p.sold %></div></div>
        <div class="meta-item"><div class="meta-item-label">Còn lại</div><div class="meta-item-value" style="color:var(--success)"><%= stock %></div></div>
      </div>

      <div class="detail-desc"><%= p.desc || '' %></div>

      <div style="background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px;margin-bottom:20px;font-size:13px;color:var(--text2)">
        <b style="color:var(--text)">Thương hiệu:</b> <%= p.thuong_hieu || 'CHOEARTH / Hypergryph' %><br>
        <b style="color:var(--text)">Danh mục:</b> <%= CATEGORIES[p.category] || '—' %><br>
        <b style="color:var(--text)">Tiết kiệm:</b> <span style="color:var(--success)"><%= fmt(p.original_price - p.price) %></span>
      </div>

      <div class="detail-qty">
        <span style="font-size:14px;color:var(--text2)">Số lượng:</span>
        <button class="qty-btn" data-qty-step="-1">−</button>
        <input class="qty-input" type="number" id="qty" value="1" min="1" max="<%= Math.max(stock, 1) %>">
        <button class="qty-btn" data-qty-step="1">+</button>
      </div>
      <button class="add-cart-btn" id="buyBtn" <%= stock <= 0 ? 'disabled' : '' %>><%= stock > 0 ? 'Thêm vào giỏ hàng' : 'Hết hàng' %></button>
      <a href="/cart" id="goCartBtn" style="display:none">
        <button class="add-cart-btn" style="margin-top:10px;background:var(--bg3);color:var(--text);border:1px solid var(--border2)">→ Xem giỏ hàng</button>
      </a>
    </div>
  </div>
  <% if (related.length) { %>
  <div style="margin-top:60px">
    <div class="section-header"><div class="section-title">Sản phẩm <span>tương tự</span></div></div>
    <div class="product-grid"><% related.forEach(function (r) { %><%- include('partials/mini-card', { p: r }) %><% }); %></div>
  </div>
  <% } %>
</div>
<%- include('partials/foot') %>

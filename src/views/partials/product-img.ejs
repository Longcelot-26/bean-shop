<% if (p.img_file) { %><img src="/imgs/<%= p.img_file %>" alt="<%= p.name %>" loading="lazy" style="width:100%;height:100%;object-fit:cover;transition:transform .3s"><% } else { %><div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:14px">No image</div><% } %>

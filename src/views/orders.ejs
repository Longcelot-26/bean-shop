<%- include('partials/head') %>
<div class="section">
  <h1 style="font-size:26px;font-weight:700;margin-bottom:28px">Đơn hàng của tôi</h1>
  <% if (orders.length === 0) { %>
    <div class="empty-cart">
      <h3><%= loggedIn ? 'Chưa có đơn hàng' : 'Vui lòng đăng nhập' %></h3>
      <p><%= loggedIn ? 'Bạn chưa đặt hàng nào' : 'Đăng nhập để xem lịch sử đơn hàng' %></p>
      <a href="<%= loggedIn ? '/products' : '/login?next=/orders' %>"><button class="btn-primary"><%= loggedIn ? 'Mua ngay' : 'Đăng nhập' %></button></a>
    </div>
  <% } %>
  <% orders.forEach(function (o) { const st = ORDER_STATUS[o.status] || ['--', '']; %>
  <div class="order-card">
    <div class="order-header">
      <div>
        <div class="order-id">Đơn #<%= o.id %></div>
        <div style="font-size:12px;color:var(--text3);margin-top:2px"><%= fmtTime(o.time) %></div>
      </div>
      <div style="text-align:right">
        <span class="order-status <%= st[1] %>"><%= st[0] %></span>
        <div style="font-size:16px;font-weight:700;color:var(--accent);margin-top:4px"><%= fmt(o.total) %></div>
      </div>
    </div>
    <div class="order-items-preview"><% (o.items || []).slice(0, 3).forEach(function (it) { %><span class="order-item-chip"><%= it.name %> x<%= it.qty %></span><% }); %></div>
    <div style="margin-top:12px;font-size:13px;color:var(--text3)"><%= o.address || '' %></div>
  </div>
  <% }); %>
</div>
<%- include('partials/foot') %>

{
  "name": "chubbylung-shop",
  "version": "1.0.0",
  "description": "shop bean bel (Express + EJS + Prisma/PostgreSQL)",
  "author": "Longcelot",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Longcelot-26/bean-shop.git"
  },
  "bugs": {
    "url": "https://github.com/Longcelot-26/bean-shop/issues"
  },
  "homepage": "https://github.com/Longcelot-26/bean-shop#readme",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/smokeTest.js",
    "db:generate": "prisma generate && node scripts/buildPrismaClient.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:import": "node scripts/importFromJson.js",
    "db:studio": "prisma studio",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "dotenv": "^18.0.7",
    "ejs": "^7.0.1",
    "esbuild": "^0.28.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  },
  "private": true,
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  }
}

# /etc/systemd/system/chubblung.service
[Unit]
Description=Chubby Lung Shop (Express)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/shop-express
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
